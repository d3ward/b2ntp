{
  "name": "b2ntp",
  "version": "2.0.0",
  "description": "Bring your bookmarks to the homepage with a customizable Kanban style board, tailor your browsing experience to fit your flow",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-ext": "vite --config vite.ext.config.js",
    "build": "vite build",
    "build-ext": "vite build --config vite.ext.config.js",
    "build-ext-dev": "vite build --config vite.ext.config.js --mode development",
    "preview": "vite preview",
    "lint": "eslint  'src/**/*.{js,ts}' && echo 'Linting complete!'",
    "lint-fix": "eslint  'src/**/*.{js,ts}' --fix",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3ward/b2ntp.git"
  },
  "author": "Eduard Ursu",
  "license": "(CC BY-NC-SA 4.0)",
  "bugs": {
    "url": "https://github.com/d3ward/b2ntp/issues"
  },
  "homepage": "https://d3ward.github.io/b2ntp",
  "sideEffects": false,
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "postcss-preset-env": "^10.2.4",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "vite": "^8.0.7",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "baseline-browser-mapping": "^2.10.27",
    "caniuse-lite": "^1.0.30001791",
    "croppie": "^2.6.5",
    "daisyui": "^5.6.22",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "markdown-it": "^14.1.0",
    "marked": "^16.0.0",
    "tailwindcss": "^4.3.3",
    "vanilla-picker": "^2.12.3"
  }
}
